{
    "name": "fabric-workspace-deployment",
    "$schema": "node_modules/nx/schemas/project-schema.json",
    "projectType": "application",
    "targets": {
        "sync": {
            "executor": "nx:run-commands",
            "cache": false,
            "options": {
                "command": "uv sync --frozen --all-groups --no-install-project"
            }
        },
        "format": {
            "executor": "nx:run-commands",
            "dependsOn": [
                "sync"
            ],
            "options": {
                "command": "uv run --frozen black --line-length 2000 ."
            }
        },
        "format-check": {
            "executor": "nx:run-commands",
            "dependsOn": [
                "sync"
            ],
            "options": {
                "command": "uv run --frozen black --check --diff --line-length 2000 ."
            }
        },
        "lint": {
            "executor": "nx:run-commands",
            "dependsOn": [
                "sync"
            ],
            "options": {
                "command": "uv run --frozen black --check --diff --line-length 2000 ."
            }
        },
        "test": {
            "executor": "nx:run-commands",
            "dependsOn": [
                "sync"
            ],
            "outputs": [
                "{workspaceRoot}/reports/pytest.xml"
            ],
            "options": {
                "command": "mkdir -p reports && uv run --frozen pytest --junitxml=reports/pytest.xml tests"
            }
        },
        "type-check": {
            "executor": "nx:run-commands",
            "dependsOn": [
                "sync"
            ],
            "options": {
                "command": "uv run --frozen mypy src/fabric_workspace_deployment tests"
            }
        },
        "build": {
            "executor": "nx:run-commands",
            "dependsOn": [
                "sync"
            ],
            "options": {
                "commands": [
                    "bash contrib/build-package.sh",
                    "bash contrib/build-binary.sh"
                ],
                "parallel": false
            },
            "configurations": {
                "package": {
                    "commands": [
                        "bash contrib/build-package.sh"
                    ]
                },
                "binary": {
                    "commands": [
                        "bash contrib/build-binary.sh"
                    ]
                }
            }
        },
        "clean": {
            "executor": "nx:run-commands",
            "options": {
                "command": "rm -rf build dist reports .mypy_cache .pytest_cache"
            }
        },
        "smoke": {
            "executor": "nx:run-commands",
            "dependsOn": [
                "build"
            ],
            "options": {
                "command": "bash contrib/smoke.sh"
            },
            "configurations": {
                "binary": {
                    "command": "test -x dist/fabric-workspace-deployment && dist/fabric-workspace-deployment --help >/dev/null"
                },
                "tools": {
                    "command": "bash contrib/verify-tools.sh"
                },
                "image": {
                    "command": "bash contrib/assert-minimal-image.sh"
                }
            }
        },
        "verify": {
            "executor": "nx:run-commands",
            "dependsOn": [
                "format-check",
                "test",
                "type-check",
                "build",
                "smoke"
            ],
            "options": {
                "command": "echo 'FWD verification complete.'"
            }
        },
        "run": {
            "executor": "nx:run-commands",
            "dependsOn": [
                "build"
            ],
            "options": {
                "cwd": "dist",
                "commands": [
                    {
                        "command": "./fabric-workspace-deployment",
                        "forwardAllArgs": true
                    }
                ]
            }
        },
        "publish": {
            "executor": "nx:run-commands",
            "dependsOn": [
                "format-check",
                "test",
                "type-check"
            ],
            "options": {
                "command": "bash contrib/publish.sh"
            }
        }
    }
}