{
    "name": "fabric-workspace-deployment",
    "$schema": "node_modules/nx/schemas/project-schema.json",
    "projectType": "application",
    "targets": {
        "build": {
            "executor": "nx:run-commands",
            "dependsOn": [
                "clean"
            ],
            "options": {
                "commands": [
                    "bash contrib/run-hatch.sh run build:binary"
                ],
                "parallel": false
            }
        },
        "clean": {
            "executor": "nx:run-commands",
            "options": {
                "commands": [
                    "rm -rf build dist src/*/__pycache__ .venv",
                    "bash contrib/run-hatch.sh env prune",
                    "bash contrib/run-hatch.sh env create",
                    "bash contrib/run-hatch.sh run build:clean"
                ],
                "parallel": false
            }
        },
        "run": {
            "executor": "nx:run-commands",
            "dependsOn": [
                "build"
            ],
            "options": {
                "cwd": "dist",
                "commands": [
                    {
                        "command": "./fabric-workspace-deployment",
                        "forwardAllArgs": true
                    }
                ]
            }
        },
        "lint": {
            "executor": "nx:run-commands",
            "options": {
                "commands": [
                    "bash contrib/run-hatch.sh run black --line-length 2000 ."
                ],
                "parallel": false
            }
        },
        "test": {
            "executor": "nx:run-commands",
            "cache": false,
            "options": {
                "command": "bash contrib/run-hatch.sh run test"
            }
        },
        "verify": {
            "executor": "nx:run-commands",
            "options": {
                "command": "npx --no-install nx run fabric-workspace-deployment:build"
            }
        },
        "publish": {
            "executor": "nx:run-commands",
            "dependsOn": [
                "lint"
            ],
            "options": {
                "commands": [
                    "bash contrib/publish.sh"
                ],
                "parallel": false
            }
        }
    }
}